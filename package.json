{
  "name": "mambo-proxi-web",
  "version": "0.1.0",
  "private": true,
  "description": "Site public et back-office MAMBO Proxi (Next.js).",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contract:sync": "node scripts/contract-sync.mjs",
    "contract:types": "openapi-typescript contracts/openapi.yaml --output src/lib/api/schema.d.ts --root-types --root-types-no-schema-prefix"
  },
  "dependencies": {
    "next": "16.3.8",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
