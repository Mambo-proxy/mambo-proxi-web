# URL publique de l'API (navigateur et serveur), sans `/v1` ni barre finale : `API_URL` de mambo-proxi-api. Lue au
# build (variable NEXT_PUBLIC_) : CSP `connect-src`/`img-src` et motifs d'images en dépendent.
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL de l'API depuis le serveur Next.js, si elle diffère (réseau Docker interne, ex. http://api:4000). Facultatif.
API_INTERNAL_URL=
# Relais same-origin de l'API (site et API sur deux domaines différents, ex. Vercel + sslip.io) : origine de l'API,
# sans `/v1`. Réécrit `/v1/*` vers l'API ; le navigateur y envoie les routes à cookies (`/v1/admin`, `/v1/auth`).
# Lue au build. Côté API : `COOKIE_DOMAIN` vide. Vide (par défaut) : appels directs. Ignorée avec les mocks.
# Vercel : API_RELAY_TARGET=https://13-38-208-248.sslip.io (avec NEXT_PUBLIC_API_URL identique, API_INTERNAL_URL vide,
# NEXT_PUBLIC_API_MOCKING vide, NEXT_PUBLIC_SITE_URL=https://mambo-proxi-web.vercel.app, REVALIDATE_SECRET de l'API).
API_RELAY_TARGET=
# Origine des images de la médiathèque si elle diffère de l'API (CDN devant `MEDIA_PUBLIC_URL` de l'API). Facultatif :
# par défaut `{NEXT_PUBLIC_API_URL}/v1/media`.
NEXT_PUBLIC_MEDIA_URL=
# Mocks MSW à la place de l'API : « enabled » en développement sur maquettes et dans les tests. Vide pour l'API réelle
# (lu au build : refaire `pnpm build` après un changement).
NEXT_PUBLIC_API_MOCKING=enabled
# Adresse publique du site (canonicals, sitemap, données structurées, image de partage). Doit être identique à
# `WEB_URL` de l'API (schéma, hôte et port) : c'est la seule origine autorisée par son CORS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Clé publique (site key) Cloudflare Turnstile des formulaires publics, widget invisible. Vide en développement,
# sur mocks et en e2e : aucun script chargé, jeton anti-spam vide. Clé secrète côté API uniquement.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# « production » autorise l'indexation ; toute autre valeur (préproduction, développement) bloque les robots.
SITE_ENV=development
# Secret partagé avec l'API pour POST /api/revalidate (même valeur que REVALIDATE_SECRET de mambo-proxi-api).
REVALIDATE_SECRET=change-me-revalidate-secret
# « on » force la page de maintenance (intervention d'exploitation, même si l'API est arrêtée). Facultatif.
MAINTENANCE_MODE=
# Fond de la carte des zones (Leaflet). Vide : tuiles OpenStreetMap (https://tile.openstreetmap.org/{z}/{x}/{y}.png),
# soumises à la politique d'usage de la fondation OSM. En production à fort trafic : gabarit d'un fournisseur dédié
# (clé incluse), ajouté automatiquement aux CSP, et sa mention (texte) affichée après « © contributeurs OpenStreetMap ».
NEXT_PUBLIC_MAP_TILES_URL=
NEXT_PUBLIC_MAP_TILES_CREDIT=
