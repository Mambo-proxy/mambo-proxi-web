# URL publique de l'API (navigateur et serveur).
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL de l'API depuis le serveur Next.js, si elle diffère (réseau Docker interne). Facultatif.
API_INTERNAL_URL=
# Mocks MSW à la place de l'API : « enabled » en développement sur maquettes et dans les tests.
NEXT_PUBLIC_API_MOCKING=enabled
# Adresse publique du site (canonicals, sitemap, données structurées, image de partage).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# « production » autorise l'indexation ; toute autre valeur (préproduction, développement) bloque les robots.
SITE_ENV=development
# Secret partagé avec l'API pour POST /api/revalidate (même valeur que REVALIDATE_SECRET de mambo-proxi-api).
REVALIDATE_SECRET=change-me-revalidate-secret
# « on » force la page de maintenance (intervention d'exploitation, même si l'API est arrêtée). Facultatif.
MAINTENANCE_MODE=
